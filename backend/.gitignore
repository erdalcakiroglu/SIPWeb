# Bağımlılıklar / build
node_modules/
dist/
dist-packages/

# Ortam değişkenleri
.env
.env.*
!.env.example

# --- Hassas veri: ASLA commit etme ---
# SQLite veritabanları
*.db
*.db-shm
*.db-wal
data/**/*.db

# İmzalama anahtarları (private key sızıntısı = sahte lisans üretimi)
data/license-keys/
*.pem

# Lisans dosyaları, kurulum paketleri, yedekler
*.lic
*.msi
*.sql
*.backup

# Loglar / outbox
data/mail-outbox.log
*.log

# Klasör yapısı korunsun (içerik değil)
!data/.gitkeep
!data/sessions/.gitkeep
